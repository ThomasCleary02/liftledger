{
  "name": "liftledger-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "expo-app",
    "web"
  ],
  "scripts": {
    "install:all": "npm install",
    "start": "concurrently -k -s first -n emu,web -c cyan,magenta \"npm run emulators\" \"npm run start:web\"",
    "start:web": "wait-on tcp:127.0.0.1:8080 tcp:127.0.0.1:9099 tcp:127.0.0.1:9199 -t 180000 && node scripts/seed-emulator-catalog.cjs && npm run dev -w liftledger-web",
    "emulators": "node scripts/start-emulators.cjs",
    "build:shared": "cd packages/shared && npm run build",
    "build:web": "cd web && npm run build",
    "test": "npm run test --workspaces --if-present && npm run test:rules",
    "test:rules": "node scripts/with-java.cjs npx --yes firebase-tools@13.35.1 emulators:exec --only firestore --project demo-liftledger \"npm run test:rules -w @liftledger/shared\"",
    "test:e2e": "node scripts/with-java.cjs node scripts/run-e2e.cjs",
    "generate:pwa": "node scripts/generate-pwa-assets.mjs",
    "prepare": "husky",
    "lint": "pnpm --filter '*' lint",
    "typecheck": "pnpm --filter '*' type-check",
    "type-check": "npm run type-check --workspaces",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "deploy:firestore:rules": "firebase deploy --only firestore:rules --project lift-ledger-8f627",
    "deploy:firestore:indexes": "firebase deploy --only firestore:indexes --project lift-ledger-8f627",
    "deploy:firestore": "firebase deploy --only firestore --project lift-ledger-8f627",
    "deploy:storage:rules": "firebase deploy --only storage --project lift-ledger-8f627"
  },
  "overrides": {
    "react": "19.1.9",
    "react-dom": "19.1.9"
  },
  "version": "3.1.1",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "date-fns": "^4.1.0",
    "expo": "~54.0.22",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.0.0",
    "react": "19.1.9",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.5"
  }
}
