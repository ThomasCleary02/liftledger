# Not required for `npm run start` (local emulators). Required for production
# deploys and for `NEXT_PUBLIC_USE_PRODUCTION=true`.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Local emulator admin (your throwaway signup email). Production admin emails
# belong in the Netlify env, not in a committed file.
NEXT_PUBLIC_ADMIN_EMAILS=

# Opt `next dev` back into the live Firebase project. Do not set this for
# normal local work. Playwright sets it so e2e can still use a real account.
# NEXT_PUBLIC_USE_PRODUCTION=true

# Playwright smoke tests (web/e2e). Copy into .env.local. Not used by Netlify.
# These credentials hit production unless you change the Playwright config.
# E2E_EMAIL=
# E2E_PASSWORD=

